{
  "author": "intuit-svc <opensource-svc@intuit.com>",
  "baseBranch": "main",
  "versionBranches": true,
  "prereleaseBranches": ["next", "version-2"],
  "noVersionPrefix": true,
  "owner": "player-ui",
  "repo": "player",
  "plugins": [
    [
      "all-contributors",
      {
        "exclude": ["intuit-svc", "Copilot", "copilot"],
        "types": {
          "example": [
            "**/*.stories*",
            "**/*.story.*",
            "**/mocks/**"
          ],
          "infra": [
            "**/.circle/**/*",
            "**/.circleci/**/*",
            "**/.github/**/*",
            "**/travis.yml"
          ],
          "test": [
            "**/*.test.*",
            "**/test/**",
            "**/__tests__/**",
            "**/Tests/**",
            "**/ViewInspector/**",
            "**/androidTest/**"
          ],
          "code": [
            "**/src/**/*",
            "**/lib/**/*",
            "**/Sources/**/*",
            "**/package.json",
            "**/tsconfig.json"
          ]
        }
      }
    ],
    [
      "version-file",
      {
        "versionFile": "./VERSION",
        "publishScript": "./scripts/release.sh",
        "publishScriptReleaseTypeArgs": {
          "next": [
            "next"
          ]
        }
      }
    ],
    [
      "omit-release-notes",
      {
        "labels": "release"
      }
    ],
    "./scripts/delete-old-prerelease.js",
    "./scripts/next-changelogs.js",
    "./scripts/version-comment.js",
    "./scripts/ios-version.js",
    "./scripts/docs/release-docs.js"
  ]
}
